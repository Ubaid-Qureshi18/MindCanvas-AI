# =============================================================================
# MindCanvas — Environment Variables
# Copy this file to .env.local (frontend) and apps/api/.env (backend)
# NEVER commit real secrets to source control
# =============================================================================

# ── AI Providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Search Providers ──────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Next.js Public Env (prefix NEXT_PUBLIC_) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── NestJS API ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# ── Redis (optional for Phase 2) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Stripe (Phase 2) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_TEAM_PRICE_ID=price_xxx

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BUCKET=mindcanvas-exports
